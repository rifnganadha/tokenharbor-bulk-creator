# tokenharbor-bulk-creator configuration
# Copy to `.env`. CLI flags override these. Never commit a real `.env`.

# Inbox backend. `temp-email-dev` drives the temp-email.dev UI in a browser.
# `smtp-dev` uses the smtp.dev email-testing API (see TH_INBOX_API_KEY).
# `custom` expects a classic temp-mail REST API (see TH_MAIL_BASE_URL).
TH_INBOX_PROVIDER=temp-email-dev

# Base URL for the `smtp-dev` provider (default https://api.smtp.dev) and the
# `custom` provider (e.g. https://api.mail.tm).
TH_MAIL_BASE_URL=

# API key for the `smtp-dev` provider. Create one at https://smtp.dev/tokens/.
# Example: smtplabs_xxxxxxxxxxxx
TH_INBOX_API_KEY=

# Pin an inbox domain for the `smtp-dev` / `custom` provider. Leave empty to auto-pick.
TH_MAILBOX_DOMAIN=

# Max ms to wait for the verification email once the inbox is open.
TH_TIMEOUT=180000

# Max ms to wait for a Cloudflare Turnstile challenge. Token Harbor currently
# serves no Turnstile widget, so this is a no-op; kept for parity.
TH_TURNSTILE_TIMEOUT=150000

# Retries per account on transient failures (mail delay, network).
# Rate-limit errors abort immediately (retrying will not help).
TH_RETRIES=3

# Number of accounts and parallelism.
TH_COUNT=1
TH_CONCURRENCY=1

# Fixed account password (>= 12 characters). Leave empty for a random one.
TH_PASSWORD=

# Optional fixed API-key label. Leave empty for a random one.
TH_KEY_NAME=

# Set to 1 to run the browser visibly (debugging).
TH_HEADFUL=0

# Set to 1 to leave the browser open after the run (debugging).
TH_KEEP_BROWSER=0

# ---- Proxy ----------------------------------------------------------------
# Route the browser (and therefore all form traffic) through a proxy.
# Format: http://user:pass@host:port  or  socks5://host:port
# Leave empty for a direct connection.
TH_PROXY=

# Alternative: TH_PROXY is also read from PROXY_URL / HTTPS_PROXY.

# ---- 9Router --------------------------------------------------------------
# Connect each freshly created Token Harbor key to a 9Router gateway.
# Opt in per run with `--connect-9router` (or set TH_CONNECT_9ROUTER=1).
TH_CONNECT_9ROUTER=0

# 9Router dashboard URL. Default: http://localhost:20128
TH_9ROUTER_URL=

# 9Router dashboard password. Default: 123456
TH_9ROUTER_PASSWORD=
